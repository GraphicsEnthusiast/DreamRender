#version 460
#extension GL_ARB_shading_language_include : require
#extension GL_NV_shader_atomic_float : require

#include "integrator/integrator.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(r32f, binding = 0) uniform image2D OutputTexR;
layout(r32f, binding = 1) uniform image2D OutputTexG;
layout(r32f, binding = 2) uniform image2D OutputTexB;
layout(location = 0) uniform uint FrameCounter;

vec3 camera_position = vec3(15.0f);
vec3 camera_target = vec3(0.0f, 3.0f, 0.0f);
vec3 camera_up = vec3(0.0f, 1.0f, 0.0f);
vec2 resolution = vec2(1280.0f, 720.0f);
float camera_fov = 60.0f;
float camera_distance = 1.0f;
float camera_aperture = 0.1f;
float camera_focal_distance = 10.0f;

/**
 * @brief Atomically accumulate color to a pixel
 * @param pixel Pixel coordinates
 * @param color RGB color value
 */
void AtomicAddColor(ivec2 pixel, vec3 color) {
    if (pixel.x < 0 || pixel.x >= int(resolution.x) || 
        pixel.y < 0 || pixel.y >= int(resolution.y)) {
        return;
    }
    
    imageAtomicAdd(OutputTexR, pixel, color.r);
    imageAtomicAdd(OutputTexG, pixel, color.g);
    imageAtomicAdd(OutputTexB, pixel, color.b);
}

// =================================================== Light Tracing ===================================================
/**
 * @brief Computes visibility from shading point to camera, accounting for medium transmittance
 * @param position Starting position of the ray (shading point)
 * @param camera_sample_info Camera sampling information containing direction and distance
 * @param beta Current path throughput (used for medium evaluation)
 * @param lambda Sampled wavelengths for spectral rendering
 * @param sobol_sampler Sobol sampler for random number generation
 * @return SampledSpectrum representing the visibility (including transmittance)
 */
SampledSpectrum DirectCameraVisibility(vec3 position, CameraSampleInfo camera_sample_info, SampledSpectrum beta, 
                                 SampledWavelengths lambda, inout SobolSampler sobol_sampler) {
    
    float shadow_distance_remaining = camera_sample_info.distance;
    vec3 shadow_origin = position;
    SampledSpectrum visibility = SampledSpectrumNewFloat(1.0f);
    
    while (true) {
        Ray shadow_ray = SpawnShadowRay(shadow_origin, camera_sample_info.world_l, shadow_distance_remaining);
        Hit occlusion_hit = BVHTraverse(shadow_ray);
        
        // If no intersection, we've reached the camera
        if (occlusion_hit.distance >= shadow_ray.tmax) {
            // Successfully reached the camera
            break;
        }
        else {
            // Get information about the intersected object
            IntersectionInfo occlusion_info = GetIntersectionInfo(occlusion_hit, shadow_ray.direction, lambda);
            
            // Check if it's a boundary material
            if (!HitBoundaryMaterial(occlusion_info)) {
                // Not a boundary material, occluded
                visibility = MulFloat(visibility, 0.0f);

                break;
            }
            
            // Handle boundary material
            if (occlusion_info.has_medium) {
                MediumEvalInfo medium_eval_info = MediumDistanceEvaluate(occlusion_info, beta, false);
                
                if (medium_eval_info.pdf > 0.0f) {
                    // Update transmittance and PDF
                    visibility = Mul(visibility, DivFloat(medium_eval_info.transmittance, medium_eval_info.pdf));
                }
            }
            
            shadow_distance_remaining -= occlusion_info.distance;
            shadow_origin = occlusion_info.position;
        }
    }

    return visibility;
}

/**
 * @brief Light tracing integrator for forward light path simulation
 * @param pixel_coords Current pixel coordinates
 * @param max_bounce Maximum number of ray bounces
 */
void LightTracing(ivec2 pixel_coords, float max_bounce) {
    // Create camera
    Camera camera = CreateCamera(
        camera_position, camera_target, camera_up,
        resolution, camera_distance, camera_fov,
        camera_aperture, camera_focal_distance
    );

    // Initialize Sobol sampler
    SobolSampler sobol_sampler = SobolSamplerNew(FrameCounter);
    SobolSamplerSetPixel(sobol_sampler, pixel_coords.x, pixel_coords.y);
    SobolSamplerNextSamples(sobol_sampler, FrameCounter);

    // Sample wavelengths
    float wavelength_sample = SobolSamplerGet1(sobol_sampler);
    SampledWavelengths lambda = SampledWavelengthsSampleVisible(wavelength_sample);

    // Generate initial light ray
    LightRayInfo light_ray_info = GenerateLightRay(sobol_sampler, lambda);
    
    // Initialize path throughput
    SampledSpectrum beta = SampledSpectrumNewFloat(1.0f);
    if (light_ray_info.pdf > 0.0f) {
        beta = Mul(beta, DivFloat(MulFloat(light_ray_info.emission, light_ray_info.cosine), light_ray_info.pdf));
    }

    vec2 camera_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
    CameraSampleInfo camera_sample_info = CameraSample(camera, light_ray_info.ray.origin, camera_sample);
    if (camera_sample_info.pdf > 0.0f) {
        FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
                    
        if (filter_evaluate_info.pdf > 0.0f) {
            beta = MulFloat(beta, filter_evaluate_info.weight / filter_evaluate_info.pdf);
            SampledSpectrum visibility = DirectCameraVisibility(light_ray_info.ray.origin, camera_sample_info, beta, lambda, sobol_sampler);
            SampledSpectrum L_camera = Mul(light_ray_info.emission, visibility);
                            
            // Convert to RGB and atomically add
            RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
            AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
        }
    }
    
    // Initialize ray state
    vec3 world_v = -light_ray_info.ray.direction;
    vec3 world_l = light_ray_info.ray.direction;
    vec3 last_position = light_ray_info.ray.origin;
    Ray ray = light_ray_info.ray;
    
    for (int bounce = 0; bounce < max_bounce; ++bounce) {
        Hit hit = BVHTraverse(ray);
        IntersectionInfo info = GetIntersectionInfo(hit, world_l, lambda);
        
        // Handle medium interaction
        bool is_medium_scattered = false;
        if (info.has_medium) {
            // Medium Distance Sampling
            vec2 medium_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
            MediumSampleInfo medium_sample_info = MediumDistanceSample(info, beta, medium_sample);
            
            if (medium_sample_info.pdf > 0.0f) {
                beta = Mul(beta, DivFloat(medium_sample_info.transmittance, medium_sample_info.pdf));
            }
            
            if (medium_sample_info.scattered) {
                is_medium_scattered = true;
                info = UpdateIntersectionInfoByMedium(info, medium_sample_info.distance, last_position, world_l);
                
                // Connect scattering point to camera
                vec2 camera_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
                CameraSampleInfo camera_sample_info = CameraSample(camera, info.position, camera_sample);
                if (camera_sample_info.pdf > 0.0f) {
                    FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
                    
                    if (filter_evaluate_info.pdf > 0.0f) {
                        beta = MulFloat(beta, filter_evaluate_info.weight / filter_evaluate_info.pdf);
                        SampledSpectrum visibility = DirectCameraVisibility(info.position, camera_sample_info, beta, lambda, sobol_sampler);
                        
                        PhaseEvalInfo phase_eval_info = PhaseEvaluate(info, world_v, camera_sample_info.world_l);
                        
                        if (phase_eval_info.pdf > 0.0f) {
                            // L_camera = β * visibility * phase * we_cosine / camera_pdf
                            SampledSpectrum L_camera = MulFloat(
                                Mul(Mul(beta, visibility), phase_eval_info.phase),
                                camera_sample_info.we_cosine / camera_sample_info.pdf
                            );
                            
                            // Convert to RGB and atomically add
                            RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
                            AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
                        }
                    }
                }
                
                // Phase Sampling
                vec2 phase_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
                PhaseSampleInfo phase_sample_info = PhaseSample(info, world_v, phase_sample);
                
                if (phase_sample_info.pdf > 0.0f) {
                    beta = Mul(beta, DivFloat(phase_sample_info.phase, phase_sample_info.pdf));
                    world_l = phase_sample_info.world_l;
                }
            }
        }
        
        if (!info.has_medium || !is_medium_scattered) {
            if (HitNothing(info)) {
                break;
            } else if (HitBoundaryMaterial(info)) {
                world_v = -world_l;
                last_position = info.position;
                ray = SpawnRay(info.position, world_l, info.geometry_normal, 0.0f, MaxFloat);
                bounce--;

                continue;
            } else {
                // Connect surface point to camera
                vec2 camera_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
                CameraSampleInfo camera_sample_info = CameraSample(camera, info.position, camera_sample);
                if (camera_sample_info.pdf > 0.0f) {
                    FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
                    
                    if (filter_evaluate_info.pdf > 0.0f) {
                        beta = MulFloat(beta, filter_evaluate_info.weight / filter_evaluate_info.pdf);
                        SampledSpectrum visibility = DirectCameraVisibility(info.position, camera_sample_info, beta, lambda, sobol_sampler);
                        
                        MaterialEvalInfo mat_eval_info = MaterialEvaluate(info, world_v, camera_sample_info.world_l, lambda);
                        
                        if (mat_eval_info.pdf > 0.0f) {
                            // L_camera = β * visibility * bsdf_cosine * we_cosine / camera_pdf
                            SampledSpectrum L_camera = MulFloat(
                                Mul(Mul(beta, visibility), mat_eval_info.bsdf_cosine),
                                camera_sample_info.we_cosine / camera_sample_info.pdf
                            );
                            
                            // Convert to RGB and atomically add
                            RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
                            AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
                        }
                    }
                }
                
                // BSDF Sampling
                vec2 bsdf_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
                MaterialSampleInfo mat_sample_info = MaterialSample(info, world_v, bsdf_sample, lambda);
                
                if (mat_sample_info.pdf > 0.0f) {
                    beta = Mul(beta, DivFloat(mat_sample_info.bsdf_cosine, mat_sample_info.pdf));
                    world_l = mat_sample_info.world_l;
                }
            }
        }
        
        // Russian roulette
        if (bounce > 3 && Max(beta) < 0.1f) {
            float q = max(0.05f, 1.0f - Max(beta));
            if (SobolSamplerGet1(sobol_sampler) < q) {
                break;
            }
            beta = DivFloat(beta, 1.0f - q);
        }

        // Update for next bounce
        world_v = -world_l;
        last_position = info.position;
        ray = SpawnRay(info.position, world_l, info.geometry_normal, 0.0f, MaxFloat);
    }
}
// =================================================== Light Tracing ===================================================

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >= int(resolution.y)) {
        return;
    }

    LightTracing(pixel_coords, 50);
}