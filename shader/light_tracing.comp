#version 460 core
#extension GL_ARB_shading_language_include : require
#extension GL_NV_shader_atomic_float : require

#include "integrator/integrator.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(r32f, binding = 0) uniform image2D OutputTexR;
layout(r32f, binding = 1) uniform image2D OutputTexG;
layout(r32f, binding = 2) uniform image2D OutputTexB;
uniform uint FrameCounter;
uniform int MaxBounce;
layout(std140, binding = 0) uniform CameraData {
    vec3 camera_position;
    float camera_fov;
    vec3 camera_target;
    float camera_distance;
    vec3 camera_up;
    float camera_aperture;
    vec2 resolution;
    float camera_focal_distance;
    float has_medium; // 0 if no medium, 1 if medium
    float medium_type;
    float phase_type;
    float g;
    vec3 sigma_s;
    vec3 sigma_t;
    vec3 density_min;
    vec3 density_max;
    float density_res_x;
    float density_res_y;
    float density_res_z;
    float inv_max_density;
    float density_offset;
    float padding[2];
};

/**
 * @brief Init camera parameters and create a camera object
 */
Camera InitCamera() {
    Medium camera_medium;
    camera_medium.type = int(medium_type);
    camera_medium.phase_type = int(phase_type);
    camera_medium.g = g;

    // Sample sigma_s / sigma_t at a representative wavelength (0.5 µm)
    RGB sigma_s_rgb = RGBNew(sigma_s.r, sigma_s.g, sigma_s.b);
    RGB sigma_t_rgb = RGBNew(sigma_t.r, sigma_t.g, sigma_t.b);
    RGBAlbedoSpectrum sigma_s_spectrum = RGBAlbedoSpectrumNew(sigma_s_rgb);
    RGBAlbedoSpectrum sigma_t_spectrum = RGBAlbedoSpectrumNew(sigma_t_rgb);
    camera_medium.sigma_s = RGBAlbedoSpectrumSample(sigma_s_spectrum, SampledWavelengthsSampleVisible(0.5f));
    camera_medium.sigma_t = RGBAlbedoSpectrumSample(sigma_t_spectrum, SampledWavelengthsSampleVisible(0.5f));

    camera_medium.density_min = density_min;
    camera_medium.density_max = density_max;
    camera_medium.density_resolution = ivec3(density_res_x, density_res_y, density_res_z);
    camera_medium.inv_max_density = inv_max_density;
    camera_medium.density_offset = int(density_offset);

    Camera camera = CreateCamera(
        camera_position, camera_target, camera_up,
        resolution, camera_distance, camera_fov,
        camera_aperture, camera_focal_distance,
        1.0f == has_medium, camera_medium
    );

    return camera;
}

/**
 * @brief Atomically accumulate color to a pixel
 * @param pixel Pixel coordinates
 * @param color RGB color value
 */
void AtomicAddColor(ivec2 pixel, vec3 color) {
    if (pixel.x < 0 || pixel.x >= int(resolution.x) || 
        pixel.y < 0 || pixel.y >= int(resolution.y)) {
        return;
    }
    
    imageAtomicAdd(OutputTexR, pixel, color.r);
    imageAtomicAdd(OutputTexG, pixel, color.g);
    imageAtomicAdd(OutputTexB, pixel, color.b);
}

// =================================================== Light Tracing ===================================================
/**
 * @brief Computes visibility from shading point to camera, accounting for medium transmittance
 * @param position Starting position of the ray (shading point)
 * @param camera_sample_info Camera sampling information containing direction and distance
 * @param beta Current path throughput (used for medium evaluation)
 * @param lambda Sampled wavelengths for spectral rendering
 * @param sobol_sampler Sobol sampler for random number generation
 * @return SampledSpectrum representing the visibility (including transmittance)
 */
SampledSpectrum DirectCameraVisibility(vec3 position, CameraSampleInfo camera_sample_info, SampledSpectrum beta, 
                                 SampledWavelengths lambda, inout SobolSampler sobol_sampler) {
    
    float shadow_distance_remaining = camera_sample_info.distance;
    vec3 shadow_origin = position;
    SampledSpectrum visibility = SampledSpectrumNewFloat(1.0f);
    bool has_mesh_light = MeshLightTableSize > 0;
    
    while (true) {
        Ray shadow_ray = SpawnShadowRay(shadow_origin, camera_sample_info.world_out, shadow_distance_remaining);
        Hit occlusion_hit = BVHTraverse(shadow_ray, has_mesh_light);
        
        // If no intersection, we've reached the camera
        if (occlusion_hit.distance >= shadow_ray.tmax) {
            if (camera_sample_info.has_medium) {
                IntersectionInfo medium_info;
                medium_info.has_medium = true;
                medium_info.medium = camera_sample_info.out_medium;
                medium_info = UpdateIntersectionInfoByMedium(medium_info, shadow_distance_remaining, shadow_origin, camera_sample_info.world_out);
                
                MediumEvalInfo medium_eval_info = MediumDistanceEvaluate(medium_info, beta, false, camera_sample_info.world_out, sobol_sampler);
                
                if (Valid(medium_eval_info.pdf)) {
                    // Update transmittance and PDF
                    visibility = Mul(visibility, DivFloat(medium_eval_info.transmittance, medium_eval_info.pdf));
                }
            }

            // Successfully reached the camera
            break;
        }
        else {
            // Get information about the intersected object
            IntersectionInfo occlusion_info = GetIntersectionInfo(occlusion_hit, shadow_ray.direction, lambda, TransportMode_Importance);
            
            // Check if it's a boundary material
            if (!HitBoundaryMaterial(occlusion_info)) {
                // Not a boundary material, occluded
                visibility = MulFloat(visibility, 0.0f);

                break;
            }
            
            // Handle boundary material
            if (occlusion_info.has_medium) {
                MediumEvalInfo medium_eval_info = MediumDistanceEvaluate(occlusion_info, beta, false, shadow_ray.direction, sobol_sampler);
                
                if (Valid(medium_eval_info.pdf)) {
                    // Update transmittance and PDF
                    visibility = Mul(visibility, DivFloat(medium_eval_info.transmittance, medium_eval_info.pdf));
                }
            }
            
            shadow_distance_remaining -= occlusion_info.distance;
            shadow_origin = occlusion_info.position;
        }
    }

    return visibility;
}

/**
 * @brief Light tracing integrator for forward light path simulation
 * @param pixel_coords Current pixel coordinates
 */
void LightTracing(ivec2 pixel_coords) {
    // Create camera
    Camera camera = InitCamera();

    // Initialize Sobol sampler
    SobolSampler sobol_sampler = SobolSamplerNew(FrameCounter);
    SobolSamplerSetPixel(sobol_sampler, pixel_coords.x, pixel_coords.y);
    SobolSamplerNextSamples(sobol_sampler, FrameCounter);

    // Sample wavelengths
    float wavelength_sample = SobolSamplerGet1(sobol_sampler);
    SampledWavelengths lambda = SampledWavelengthsSampleVisible(wavelength_sample);

    SampledSpectrum beta = SampledSpectrumNewFloat(1.0f);

    // Generate initial light ray
    LightRayInfo light_ray_info = GenerateLightRay(sobol_sampler, lambda);
    float light_cosine = abs(dot(light_ray_info.ray.direction, light_ray_info.shading_normal));
    
    // Initialize path throughput beta
    // beta = Le * |cosθ| / light_pdf
    if (Valid(light_ray_info.pdf)) {
        beta = Mul(beta, DivFloat(MulFloat(light_ray_info.emission, light_cosine), light_ray_info.pdf));
    }
    
    // Connect light source directly to camera
    CameraSampleInfo camera_sample_info = CameraSample(camera, light_ray_info.ray.origin, sobol_sampler);
    
    if (Valid(camera_sample_info.pdf) && dot(camera_sample_info.world_out, light_ray_info.shading_normal) > 0.0f) {
        FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
        
        if (Valid(filter_evaluate_info.pdf)) {
            SampledSpectrum visibility = DirectCameraVisibility(
                light_ray_info.ray.origin, camera_sample_info, beta, lambda, sobol_sampler
            );
            
            // Contribution = beta * visibility * filter_weight * we / (filter_pdf * camera_pdf)
            SampledSpectrum L_camera = MulFloat(
                MulFloat(Mul(beta, visibility), camera_sample_info.we / camera_sample_info.pdf),
                (filter_evaluate_info.weight / filter_evaluate_info.pdf)
            );

            RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
            AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
        }
    }
    
    // Initialize ray state
    Ray ray = light_ray_info.ray;
    vec3 world_in = -ray.direction;  // Direction from light to current point
    vec3 world_out = ray.direction;  // Direction to next bounce
    bool has_mesh_light = MeshLightTableSize > 0;
    
    for (int bounce = 0; bounce < MaxBounce; ++bounce) {
        Hit hit = BVHTraverse(ray, has_mesh_light);
        IntersectionInfo info = GetIntersectionInfo(hit, world_out, lambda, ray.transport_mode);
        
        // Handle medium scattering
        bool is_medium_scattered = false;
        if (info.has_medium) {
            // ========================= Medium Distance Sampling =========================
            // Sample medium distance to determine if scattering occurs
            MediumSampleInfo medium_sample_info = MediumDistanceSample(info, beta, world_out, lambda, sobol_sampler);
            
            if (Valid(medium_sample_info.pdf)) {
                // Update path throughput with medium transmittance
                beta = Mul(beta, DivFloat(medium_sample_info.transmittance, medium_sample_info.pdf));
            }

            // ========================= Medium Distance Sampling =========================
            
            if (medium_sample_info.scattered) {
                is_medium_scattered = true;
                
                // Update to scattering point inside medium
                info = UpdateIntersectionInfoByMedium(info, medium_sample_info.distance, ray.origin, world_out);
                
                // ========================= Volume Camera Sampling =========================
                // Connect scattering point to camera
                CameraSampleInfo camera_sample_info = CameraSample(camera, info.position, sobol_sampler);
                
                if (Valid(camera_sample_info.pdf)) {
                    FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
                    
                    if (Valid(filter_evaluate_info.pdf)) {
                        SampledSpectrum visibility = DirectCameraVisibility(
                            info.position, camera_sample_info, beta, lambda, sobol_sampler
                        );
                        
                        // Evaluate phase function at scattering point
                        PhaseEvalInfo phase_eval_info = PhaseEvaluate(info, world_in, camera_sample_info.world_out);
                        
                        if (Valid(phase_eval_info.pdf)) {
                            // Contribution = beta * visibility * phase * filter_weight * we / (filter_pdf * camera_pdf)
                            SampledSpectrum L_camera = Add(MulFloat(
                                Mul(Mul(beta, visibility), phase_eval_info.phase),
                                (camera_sample_info.we / camera_sample_info.pdf) *
                                (filter_evaluate_info.weight / filter_evaluate_info.pdf)
                            ), MulFloat(
                                    Mul(medium_sample_info.emission, visibility),
                                    (camera_sample_info.we / camera_sample_info.pdf) *
                                    (filter_evaluate_info.weight / filter_evaluate_info.pdf)
                                ));
                            
                            RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
                            AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
                        }
                    }
                }
                // ========================= Volume Camera Sampling =========================
                
                // ========================= Phase Sampling =========================
                // Sample phase function for next bounce direction
                PhaseSampleInfo phase_sample_info = PhaseSample(info, world_in, sobol_sampler);
                
                if (Valid(phase_sample_info.pdf)) {
                    // Update path throughput with phase function
                    beta = Mul(beta, DivFloat(phase_sample_info.phase, phase_sample_info.pdf));
                    world_out = phase_sample_info.world_out;
                }
                // ========================= Phase Sampling =========================
            }
        }
        
        // Handle surface scattering (if not medium scattered)
        if (!info.has_medium || !is_medium_scattered) {
            // ========================= Surface Camera Sampling =========================
            // Connect surface point to camera
            CameraSampleInfo camera_sample_info = CameraSample(camera, info.position, sobol_sampler);

            if (Valid(camera_sample_info.pdf)) {
                FilterEvaluateInfo filter_evaluate_info = GaussianFilterEvaluate(0.5f, camera_sample_info.raster_ndc);
                
                if (Valid(filter_evaluate_info.pdf)) {
                    SampledSpectrum visibility = DirectCameraVisibility(
                        info.position, camera_sample_info, beta, lambda, sobol_sampler
                    );
                    
                    MaterialEvalInfo mat_eval_info = MaterialEvaluate(info, world_in, camera_sample_info.world_out, lambda);
                    
                    if (Valid(mat_eval_info.pdf)) {
                        // Shading normal correction (Veach p.155, p.158)
                        // Check geometric vs shading normal consistency to prevent light leaks
                        float wi_dot_geo_n = dot(world_in, info.geometry_normal);
                        float wo_dot_geo_n = dot(camera_sample_info.world_out, info.geometry_normal);
                        float wi_dot_shading_n = dot(world_in, info.shading_normal);
                        float wo_dot_shading_n = dot(camera_sample_info.world_out, info.shading_normal);
                        
                        // Reject if shading normal and geometric normal disagree on orientation
                        if (wi_dot_geo_n * wi_dot_shading_n <= 0.0f ||
                            wo_dot_geo_n * wo_dot_shading_n <= 0.0f) {
                            break;
                        }
                        
                        // Adjoint BSDF correction for shading normals
                        float correction = abs(
                            (wi_dot_shading_n * wo_dot_geo_n) /
                            (wo_dot_shading_n * wi_dot_geo_n)
                        );
                        
                        float cosine = abs(dot(world_in, info.shading_normal));
                        
                        // Contribution = beta * visibility * bsdf * bsdf_cosine * correction * filter_weight * we / (filter_pdf * camera_pdf)
                        SampledSpectrum L_camera = MulFloat(
                            Mul(Mul(beta, visibility), MulFloat(MulFloat(mat_eval_info.bsdf, cosine), correction)),
                            (camera_sample_info.we / camera_sample_info.pdf) *
                            (filter_evaluate_info.weight / filter_evaluate_info.pdf)
                        );
                        
                        RGB radiance_linear_rgb = SampledSpectrumToRGB(L_camera, lambda);
                        AtomicAddColor(camera_sample_info.raster, RGBToVec3(radiance_linear_rgb));
                    }
                }
                // ========================= Surface Camera Sampling =========================
            }
            if (HitNothing(info) || HitMeshLight(info)) {
                break;
            }
            else if (HitBoundaryMaterial(info)) {
                // Continue ray through boundary
                world_in = -world_out;
                ray = SpawnRay(info.position, world_out, info.geometry_normal, 0.0f, MaxFloat, TransportMode_Importance);
                bounce--;  // Don't count boundary as a bounce

                continue;
            }
            else {
                // ========================= BSDF Sampling =========================
                // Sample BSDF for next bounce
                MaterialSampleInfo mat_sample_info = MaterialSample(info, world_in, sobol_sampler, lambda);
            
                if (Valid(mat_sample_info.pdf)) {
                    // Shading normal correction (Veach p.155, p.158)
                    // Check geometric vs shading normal consistency to prevent light leaks
                    float wi_dot_geo_n = dot(world_in, info.geometry_normal);
                    float wo_dot_geo_n = dot(mat_sample_info.world_out, info.geometry_normal);
                    float wi_dot_shading_n = dot(world_in, info.shading_normal);
                    float wo_dot_shading_n = dot(mat_sample_info.world_out, info.shading_normal);
                        
                    // Reject if shading normal and geometric normal disagree on orientation
                    if (wi_dot_geo_n * wi_dot_shading_n <= 0.0f ||
                        wo_dot_geo_n * wo_dot_shading_n <= 0.0f) {
                        break;
                    }
                        
                    // Adjoint BSDF correction for shading normals
                    float correction = abs(
                        (wi_dot_shading_n * wo_dot_geo_n) /
                        (wo_dot_shading_n * wi_dot_geo_n)
                    );

                    float cosine = abs(dot(world_in, info.shading_normal));
                    beta = Mul(beta, DivFloat(MulFloat(mat_sample_info.bsdf, cosine * correction), mat_sample_info.pdf));
                    world_out = mat_sample_info.world_out;
                }
                // ========================= BSDF Sampling =========================
            }
        }
            
        // Russian roulette
        if (bounce > 3 && Max(beta) < 0.1f) {
            float q = max(0.05f, 1.0f - Max(beta));
            if (SobolSamplerGet1(sobol_sampler) < q) {
                break;
            }
            beta = DivFloat(beta, 1.0f - q);
        }
        
        // Update for next bounce
        world_in = -world_out;
        ray = SpawnRay(info.position, world_out, info.geometry_normal, 0.0f, MaxFloat, TransportMode_Importance);
    }
}
// =================================================== Light Tracing ===================================================
 
void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >= int(resolution.y)) {
        return;
    }

    LightTracing(pixel_coords);
}