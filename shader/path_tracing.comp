#version 460 core
#extension GL_ARB_shading_language_include : require

#include "integrator/integrator.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) writeonly uniform image2D OutputTex;
uniform uint FrameCounter;
uniform int MaxBounce;
layout(std140, binding = 9) uniform CameraData {
    vec3 camera_position;
    float camera_fov;
    vec3 camera_target;
    float camera_distance;
    vec3 camera_up;
    float camera_aperture;
    vec2 resolution;
    float camera_focal_distance;
    float has_medium; // 0.0f if no medium, 1.0f if medium
    float medium_type;
    float phase_type;
    float g;
    vec3 sigma_s;
    vec3 sigma_t;
    // Padding is automatically handled by std140 layout
    // No need to explicitly declare padding[3] in GLSL
};

/**
 * @brief Init camera parameters and create a camera object
 */
Camera InitCamera() {
    Medium camera_medium;
    camera_medium.type = int(medium_type);
    camera_medium.phase_type = int(phase_type);
    camera_medium.g = g;
    RGB sigma_s_rgb = RGBNew(sigma_s.r, sigma_s.g, sigma_s.b);
    RGB sigma_t_rgb = RGBNew(sigma_t.r, sigma_t.g, sigma_t.b);
    RGBAlbedoSpectrum sigma_s_spectrum = RGBAlbedoSpectrumNew(sigma_s_rgb);
    RGBAlbedoSpectrum sigma_t_spectrum = RGBAlbedoSpectrumNew(sigma_t_rgb);
    camera_medium.sigma_s = RGBAlbedoSpectrumSample(sigma_s_spectrum, SampledWavelengthsSampleVisible(0.5f));
    camera_medium.sigma_t = RGBAlbedoSpectrumSample(sigma_t_spectrum, SampledWavelengthsSampleVisible(0.5f));
    
    Camera camera = CreateCamera(
        camera_position, camera_target, camera_up,
        resolution, camera_distance, camera_fov,
        camera_aperture, camera_focal_distance,
        1.0f == has_medium, camera_medium
    );
    
    return camera;
}

// =================================================== Path Tracing ===================================================
/**
 * @brief Computes visibility from shading point to light source, accounting for medium transmittance
 * @param position Starting position of the ray (shading point)
 * @param light_sample_info Information about the sampled light point
 * @param beta Current path throughput (used for medium evaluation)
 * @param lambda Sampled wavelengths for spectral rendering
 * @param mult_trans_pdf Accumulated PDF of the transmittance sampling (product of segment PDFs)
 * @param sobol_sampler Sobol sampler for random number generation
 * @return SampledSpectrum representing the visibility (including transmittance)
 */
SampledSpectrum DirectLightVisibility(vec3 position, LightSampleInfo light_sample_info, SampledSpectrum beta, 
                                 SampledWavelengths lambda, out float mult_trans_pdf, inout SobolSampler sobol_sampler) {
    
    float shadow_distance_remaining = light_sample_info.distance;
    vec3 shadow_origin = position;
    SampledSpectrum visibility = SampledSpectrumNewFloat(1.0f);
    mult_trans_pdf = 1.0f;
    bool has_mesh_light = MeshLightTableSize > 0;
    
    while (true) {
        Ray shadow_ray = SpawnShadowRay(shadow_origin, light_sample_info.world_out, shadow_distance_remaining);
        Hit occlusion_hit = BVHTraverse(shadow_ray, has_mesh_light);
        
        // If no intersection, we've reached the light
        if (occlusion_hit.distance >= shadow_ray.tmax) {
            if (light_sample_info.has_medium) {
                IntersectionInfo medium_info;
                medium_info.has_medium = true;
                medium_info.medium = light_sample_info.out_medium;
                medium_info = UpdateIntersectionInfoByMedium(medium_info, shadow_distance_remaining, shadow_origin, light_sample_info.world_out);
                
                MediumEvalInfo medium_eval_info = MediumDistanceEvaluate(medium_info, beta, false, light_sample_info.world_out, sobol_sampler);
                
                if (Valid(medium_eval_info.pdf)) {
                    // Update transmittance and PDF
                    mult_trans_pdf *= medium_eval_info.pdf;
                    visibility = Mul(visibility, DivFloat(medium_eval_info.transmittance, medium_eval_info.pdf));
                }
            }
            
            // Successfully reached the light
            break;
        }
        else {
            // Get information about the intersected object
            IntersectionInfo occlusion_info = GetIntersectionInfo(occlusion_hit, shadow_ray.direction, lambda, TransportMode_Radiance);
            
            // Check if it's a boundary material
            if (!HitBoundaryMaterial(occlusion_info)) {
                // Not a boundary material, occluded
                visibility = MulFloat(visibility, 0.0f);

                break;
            }
            
            // Handle boundary material
            if (occlusion_info.has_medium) {
                MediumEvalInfo medium_eval_info = MediumDistanceEvaluate(occlusion_info, beta, false, shadow_ray.direction, sobol_sampler);
                
                if (Valid(medium_eval_info.pdf)) {
                    // Update transmittance and PDF
                    mult_trans_pdf *= medium_eval_info.pdf;
                    visibility = Mul(visibility, DivFloat(medium_eval_info.transmittance, medium_eval_info.pdf));
                }
            }
            
            shadow_distance_remaining -= occlusion_info.distance;
            shadow_origin = occlusion_info.position;
        }
    }

    return visibility;
}

/**
 * @brief Path tracing integrator with multiple importance sampling
 * @param pixel_coords Current pixel coordinates
 */
void PathTracing(ivec2 pixel_coords) {
    // Create camera
    Camera camera = InitCamera();

    // Initialize Sobol sampler
    SobolSampler sobol_sampler = SobolSamplerNew(FrameCounter);
    SobolSamplerSetPixel(sobol_sampler, pixel_coords.x, pixel_coords.y);
    SobolSamplerNextSamples(sobol_sampler, FrameCounter);

    // Sample wavelengths
    float wavelength_sample = SobolSamplerGet1(sobol_sampler);
    SampledWavelengths lambda = SampledWavelengthsSampleVisible(wavelength_sample);

    vec2 pixel_center = vec2(pixel_coords) + vec2(0.5f);
    vec2 filter_sample = vec2(SobolSamplerGet1(sobol_sampler), SobolSamplerGet1(sobol_sampler));
    FilterSampleInfo filter_sample_info = GaussianFilterSample(0.5f, filter_sample);
    pixel_center += filter_sample_info.offset;

    SampledSpectrum beta = SampledSpectrumNewFloat(1.0f);
    SampledSpectrum radiance = SampledSpectrumNewFloat(0.0f);

    CameraRayInfo camera_ray_info = GenerateCameraRay(camera, pixel_center.x, pixel_center.y, sobol_sampler);

    if (Valid(filter_sample_info.pdf)) {
        beta = MulFloat(beta, filter_sample_info.weight / filter_sample_info.pdf);
    }

    if (Valid(camera_ray_info.pdf)) {
        float camera_cosine = abs(dot(camera_ray_info.ray.direction, -camera.forward));
        beta = MulFloat(beta, camera_ray_info.we * camera_cosine / camera_ray_info.pdf);
    }

    Ray ray = camera_ray_info.ray;
    vec3 world_in = -ray.direction;
    vec3 world_out = ray.direction;
    vec3 last_position = ray.origin;
    float bsdf_phase_pdf = 1.0f;  // bsdf or phase pdf
    float mult_trans_pdf = 1.0f;
    bool has_mesh_light = MeshLightTableSize > 0;

    for (int bounce = 0; bounce < MaxBounce; ++bounce) {
        Hit hit = BVHTraverse(ray, has_mesh_light);
        IntersectionInfo info = GetIntersectionInfo(hit, world_out, lambda, ray.transport_mode);
        
        // Handle medium interaction
        bool is_medium_scattered = false;
        if (info.has_medium) {
            // ========================= Medium Distance Sampling =========================
            // Determine whether the next ray bounce is a surface bounce or a volume bounce
            MediumSampleInfo medium_sample_info = MediumDistanceSample(info, beta, world_out, sobol_sampler);
            
            if (Valid(medium_sample_info.pdf)) {
                beta = Mul(beta, DivFloat(medium_sample_info.transmittance, medium_sample_info.pdf));
                mult_trans_pdf *= medium_sample_info.pdf;
            }
            // ========================= Medium Distance Sampling =========================
            
            if (medium_sample_info.scattered) {
                is_medium_scattered = true;

                // Update to scattering point
                info = UpdateIntersectionInfoByMedium(info, medium_sample_info.distance, last_position, world_out);
                
                // ========================= Volume Light Sampling(MIS) =========================
                // Sampling direct illumination within the volume
                float mult_trans_pdf_nee = 1.0f;
                LightSampleInfo light_sample_info = LightSample(sobol_sampler, info, lambda);
                
                // Compute visibility and medium transmittance
                SampledSpectrum visibility = DirectLightVisibility(info.position, light_sample_info, beta, lambda, mult_trans_pdf_nee, sobol_sampler);
                
                // Evaluate phase function
                PhaseEvalInfo phase_eval_info = PhaseEvaluate(info, world_in, light_sample_info.world_out);
                
                if (Valid(light_sample_info.pdf) && Valid(phase_eval_info.pdf) && Valid(mult_trans_pdf_nee)) {
                    float mis_weight = PowerHeuristic(light_sample_info.pdf, phase_eval_info.pdf * mult_trans_pdf_nee, 2.0f);

                    // L_light = β * visibility * mis_weight * Le * phase / light_pdf
                    SampledSpectrum L_light = Mul(MulFloat(Mul(beta, visibility), mis_weight),
                        DivFloat(Mul(light_sample_info.emission, phase_eval_info.phase), light_sample_info.pdf));
                    
                    radiance = Add(radiance, L_light);
                }
                // ========================= Volume Light Sampling(MIS) =========================
                
                // ========================= Phase Sampling =========================
                // Sample phase function direction
                PhaseSampleInfo phase_sample_info = PhaseSample(info, world_in, sobol_sampler);
                
                if (Valid(phase_sample_info.pdf)) {
                    beta = Mul(beta, DivFloat(phase_sample_info.phase, phase_sample_info.pdf));
                    world_out = phase_sample_info.world_out;
                    bsdf_phase_pdf = phase_sample_info.pdf;
                }
                // ========================= Phase Sampling =========================
            }
        }
        
        if (!info.has_medium || !is_medium_scattered) {
            // ========================= BSDF or Phase Sampling(MIS) =========================
            // Handle hitting a light source
            bool hit_nothing = HitNothing(info);
            bool hit_mesh_light = HitMeshLight(info);
            if (hit_nothing || hit_mesh_light) {
                float mis_weight = 1.0f;
                int light_type = hit_nothing ? LightType_Environment : LightType_Mesh;
                LightEvalInfo light_eval_info = LightEvaluate(light_type, world_out, info, last_position, lambda);

                if (0 != bounce) {
                    mis_weight = PowerHeuristic(bsdf_phase_pdf * mult_trans_pdf, light_eval_info.pdf, 2.0f);
                }

                if (Valid(light_eval_info.pdf) && Valid(bsdf_phase_pdf) && Valid(mult_trans_pdf)) {
                    // L_material_or_medium = β * visibility * mis_weight * Le * (bsdf * cos or phase) / bsdf_phase_pdf
                    //                      = β' * mis_weight * Le
                    SampledSpectrum L_material_or_medium = MulFloat(Mul(beta, light_eval_info.emission), mis_weight);
                    radiance = Add(radiance, L_material_or_medium);
                }

                break;
            }
            // ========================= BSDF or Phase Sampling(MIS) =========================
            // Handle hitting medium boundary
            else if (HitBoundaryMaterial(info)) {
                world_in = -world_out;
                last_position = info.position;
                ray = SpawnRay(info.position, world_out, info.geometry_normal, 0.0f, MaxFloat, TransportMode_Radiance);
                bounce--;  // Don't count this as a bounce

                continue;
            }
            // Handle regular surface interaction
            else {
                // ========================= Surface Light Sampling(MIS) =========================
                // Sampling direct illumination on the surface
                float mult_trans_pdf_nee = 1.0f;
                LightSampleInfo light_sample_info = LightSample(sobol_sampler, info, lambda);
                
                // Compute visibility and medium transmittance
                SampledSpectrum visibility = DirectLightVisibility(info.position, light_sample_info, beta, lambda, mult_trans_pdf_nee, sobol_sampler);
                
                // Evaluate BSDF
                MaterialEvalInfo mat_eval_info = MaterialEvaluate(info, world_in, light_sample_info.world_out, lambda);
                
                if (Valid(light_sample_info.pdf) && Valid(mat_eval_info.pdf) && Valid(mult_trans_pdf_nee)) {
                    float mis_weight = PowerHeuristic(light_sample_info.pdf, mat_eval_info.pdf * mult_trans_pdf_nee, 2.0f);
                    // L_light = β * visibility * mis_weight * Le * bsdf * cos / light_pdf
                    float cosine = abs(dot(light_sample_info.world_out, info.shading_normal));
                    SampledSpectrum L_light = Mul(MulFloat(Mul(beta, visibility), mis_weight),
                        DivFloat(Mul(light_sample_info.emission, MulFloat(mat_eval_info.bsdf, cosine)), light_sample_info.pdf));
                    
                    radiance = Add(radiance, L_light);
                }
                // ========================= Surface Light Sampling(MIS) =========================

                // ========================= BSDF Sampling =========================
                // Sample BSDF direction
                MaterialSampleInfo mat_sample_info = MaterialSample(info, world_in, sobol_sampler, lambda);
                
                if (Valid(mat_sample_info.pdf)) {
                    float cosine = abs(dot(mat_sample_info.world_out, info.shading_normal));
                    beta = Mul(beta, DivFloat(MulFloat(mat_sample_info.bsdf, cosine), mat_sample_info.pdf));
                    world_out = mat_sample_info.world_out;
                    bsdf_phase_pdf = mat_sample_info.pdf;
                }
                // ========================= BSDF Sampling =========================
            }
        }
        
        // Russian roulette
        if (bounce > 3 && Max(beta) < 0.1f) {
            float q = max(0.05f, 1.0f - Max(beta));
            if (SobolSamplerGet1(sobol_sampler) < q) {
                break;
            }
            beta = DivFloat(beta, 1.0f - q);
        }

        // Update for next bounce
        world_in = -world_out;
        mult_trans_pdf = 1.0f;
        last_position = info.position;
        ray = SpawnRay(info.position, world_out, info.geometry_normal, 0.0f, MaxFloat, TransportMode_Radiance);
    }
    
    RGB radiance_linear_rgb = SampledSpectrumToRGB(radiance, lambda);
    imageStore(OutputTex, pixel_coords, vec4(RGBToVec3(radiance_linear_rgb), 1.0f));
}
// =================================================== Path Tracing ===================================================

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >= int(resolution.y)) {
        return;
    }

    PathTracing(pixel_coords);
}