#version 460

#extension GL_ARB_shading_language_include : require

#include "shape/shape.glsl"
#include "spectrum/spectrum.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) writeonly uniform image2D outputTex;

uniform vec3 camera_position = vec3(10.0, 10.0, 10.0);
uniform vec3 camera_target = vec3(0.0, 0.0, 0.0);
uniform vec3 camera_up = vec3(0.0, 1.0, 0.0);
uniform vec2 resolution = vec2(1280.0, 720.0);
uniform float camera_fov = 60.0;
uniform float camera_distance = 1.0;
uniform float camera_aperture = 0.1;
uniform float camera_focal_distance = 10.0;

void main()
{
    // 获取全局线程ID
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    
    // 边界检查
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >=int(resolution.y)) {
        return;
    }
    
    // 创建相机
    Camera cam = CreateCamera(camera_position, camera_target, camera_up, 
                             resolution, camera_distance, camera_fov, 
                             camera_aperture, camera_focal_distance, false, 0);
    
    // 生成像素坐标
    vec2 pixel_center = vec2(pixel_coords) + vec2(0.5);
    vec2 random_offset = vec2(0.0); // 无随机偏移，确保确定性测试
    
    // 生成主光线
    Ray ray = GeneratePrimaryRay(cam, pixel_center.x, pixel_center.y, random_offset);
    
    // 使用BVH遍历寻找交点
    Hit hit = BVHTraverse(ray);
    
    vec4 color;
    if (hit.distance < MaxFloat) {
        // 命中几何体：获取三角形并计算法线
        Triangle tri = FetchTriangle(hit.tri_index);
        
        // 插值计算法线
        vec3 normal = normalize((1.0 - hit.u - hit.v) * tri.n1 + 
                               hit.u * tri.n2 + 
                               hit.v * tri.n3);
        
        // 法线着色：将法线从[-1,1]映射到[0,1]
        color = vec4(normal * 0.5 + 0.5, 1.0);
    } else {
        // 未命中：使用背景色
        // 使用《Ray Tracing in One Weekend》中的背景色计算方法
        vec3 unit_direction = normalize(ray.direction);
        float t = 0.5 * (unit_direction.y + 1.0); // 将y分量从[-1,1]映射到[0,1]
        vec3 bg_color = mix(vec3(1.0, 1.0, 1.0), // 白色
                            vec3(0.5, 0.7, 1.0), // 浅蓝色
                            t);
        color = vec4(bg_color, 1.0);
    }


    // 1. 定义输入RGB颜色（假设在sRGB颜色空间）
    RGB rgb = RGBNew(0.0f, 0.0f, 0.9f);

    // 2. 将RGB转换为光谱系数（需要颜色空间信息）
    RGBSigmoidPolynomial rsp = ToRGBCoeffs(rgb); // 依赖于颜色空间查找表

    // 3. 创建光谱对象（例如用于反射率）
    RGBAlbedoSpectrum albedoSpectrum = RGBAlbedoSpectrumNew(rsp);

    // 4. 采样可见光谱波长（使用重要性采样）
    SampledWavelengths waves = SampledWavelengthsSampleVisible(0.5f); // 0.5是随机种子

    // 5. 在采样波长处评估光谱值
    SampledSpectrum sampled;
    for (int i = 0; i < NSpectrumSamples; i++) {
        sampled.values[i] = RGBAlbedoSpectrumEval(albedoSpectrum, waves.lambda[i]);
    }
    
    // 
    RGB outputRgb = SampledSpectrumToRGB(sampled, waves); 
    color = vec4(vec3(outputRgb.r, outputRgb.g, outputRgb.b), 1.0);
    //color = vec4(vec3(rgb.r, rgb.g, rgb.b), 1.0);

    RGB blue = RGBNew(0.0, 0.0, 0.9);
	RGBSigmoidPolynomial coeffs = ToRGBCoeffs(blue);
    float X = 0.0f, Y = 0.0f, Z = 0.0f;
    for (int i = 0; i < 471; i++) {
        float lambda = LambdaMin + float(i);
        X += RGBSigmoidPolynomialEval(coeffs,lambda) * CIEX[i];
        Y += RGBSigmoidPolynomialEval(coeffs,lambda) * CIEY[i]; 
        Z += RGBSigmoidPolynomialEval(coeffs,lambda) * CIEZ[i]; 
    }
    RGB reconstructed_rgb = XYZToRGB(XYZ(X, Y, Z));
	float redValue = RGBSigmoidPolynomialEval(coeffs,650.f); 
	float blueValue = RGBSigmoidPolynomialEval(coeffs,450.f);

    if (blueValue >= 2.0f * redValue) {
        color = vec4(0.0,0.0,1.0,1.0);
    }
    else {
        color = vec4(1.0,0.0,0.0,1.0);
    }
    color = vec4(reconstructed_rgb.r, reconstructed_rgb.g,reconstructed_rgb.b, 1.0f);
    color = vec4(vec3(outputRgb.r, outputRgb.g, outputRgb.b), 1.0);s
    // 输出到图像
    imageStore(outputTex, pixel_coords, color);
}