#version 460
#extension GL_ARB_shading_language_include : require

#include "integrator/integrator.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) writeonly uniform image2D outputTex;
layout(location = 0) uniform uint FrameCounter;

// Camera parameters
vec3 camera_position = vec3(15.0, 15.0, 15.0);
vec3 camera_target = vec3(0.0, 3.0, 0.0);
vec3 camera_up = vec3(0.0, 1.0, 0.0);
vec2 resolution = vec2(1280.0, 720.0);
float camera_fov = 60.0;
float camera_distance = 1.0;
float camera_aperture = 0.1;
float camera_focal_distance = 10.0;

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >= int(resolution.y)) {
        return;
    }

    // Create camera
    Camera cam = CreateCamera(
        camera_position, camera_target, camera_up,
        resolution, camera_distance, camera_fov,
        camera_aperture, camera_focal_distance, false, 0
    );

    // Initialize Sobol sampler
    SobolSampler sobol_sampler = SobolSamplerNew(FrameCounter);
    SobolSamplerSetPixel(sobol_sampler, pixel_coords.x, pixel_coords.y);
    SobolSamplerNextSamples(sobol_sampler, FrameCounter);

    // Sample wavelengths
    float wavelength_sample = SobolSamplerGet1(sobol_sampler);
    SampledWavelengths lambda = SampledWavelengthsSampleVisible(wavelength_sample);

    // Use the PathTracing function
    SampledSpectrum L = PathTracing(pixel_coords, cam, sobol_sampler, lambda, 10);

    RGB linear_rgb = SampledSpectrumToRGB(L, lambda);
    RGB display_rgb = LinearToSRGB(linear_rgb);

    imageStore(outputTex, pixel_coords, vec4(display_rgb.r, display_rgb.g, display_rgb.b, 1.0));
}