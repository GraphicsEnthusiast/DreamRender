vec3 camera_pos = vec3(0.0f, 1.0f, 5.0f);
vec3 camera_target = vec3(0.0f, 0.0f, 0.0f);
float camera_fov = radians(60.0f);

void main()
{
    // 获取当前像素坐标
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 image_size = imageSize(outputTex);
    
    // 计算UV坐标 (0到1范围)
    vec2 uv = vec2(pixel_coord) / vec2(image_size);
    
    // 创建相机坐标系
    vec3 camera_dir = normalize(camera_target - camera_pos);
    vec3 camera_right = normalize(cross(vec3(0.0, 1.0, 0.0), camera_dir));
    vec3 camera_up = cross(camera_dir, camera_right);
    
    // 计算射线方向 (透视投影)
    float aspect_ratio = float(image_size.x) / float(image_size.y);
    vec2 screen_pos = uv * 2.0 - 1.0; // 转换为NDC坐标 (-1到1)
    screen_pos.x *= aspect_ratio * tan(camera_fov * 0.5);
    screen_pos.y *= tan(camera_fov * 0.5);
    
    vec3 ray_dir = normalize(camera_dir + camera_right * screen_pos.x + camera_up * screen_pos.y);
    
    // 创建测试射线
    Ray test_ray;
    test_ray.origin = camera_pos;
    test_ray.direction = ray_dir;
    test_ray.tmin = 0.001;
    test_ray.tmax = MaxFloat;
    
    // 执行BVH遍历
    Hit hit = BVHTraverse(test_ray);
    //Hit hit;
    //hit.distance = test_ray.tmax;
    //hit.u = 0.0f;
    //hit.v = 0.0f;
    //hit.tri_index = 0;
    // 根据命中结果计算颜色
    vec4 color;
    if (hit.distance < MaxFloat) {
        // 命中物体 - 使用基于距离和三角形索引的颜色
        float intensity = 1.0 - clamp(hit.distance / 20.0, 0.0, 1.0);
        
        // 基于三角形索引生成不同颜色
        vec3 object_color = vec3(
            float(hit.tri_index % 256) / 255.0,
            float((hit.tri_index / 256) % 256) / 255.0,
            float((hit.tri_index / 65536) % 256) / 255.0
        );
        
        color = vec4(object_color * intensity, 1.0);
    } else {
        // 未命中 - 显示简单的背景渐变
        vec3 bg_color = mix(vec3(0.1, 0.1, 0.2), vec3(0.05, 0.05, 0.1), uv.y);
        color = vec4(bg_color, 1.0);
    }
    
    // 将结果写入输出图像
    imageStore(outputTex, pixel_coord, color);
}