#version 460
#extension GL_ARB_shading_language_include : require

#include "shape/shape.glsl"
#include "material/material.glsl"
#include "sample/filter.glsl"
#include "camera/camera.glsl"
#include "spectrum/spectrum.glsl"
#include "sample/sampler.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) writeonly uniform image2D outputTex;

// Camera parameters
uniform vec3 camera_position = vec3(10.0, 10.0, 10.0);
uniform vec3 camera_target = vec3(0.0, 0.0, 0.0);
uniform vec3 camera_up = vec3(0.0, 1.0, 0.0);
uniform vec2 resolution = vec2(1280.0, 720.0);
uniform float camera_fov = 60.0;
uniform float camera_distance = 1.0;
uniform float camera_aperture = 0.1;
uniform float camera_focal_distance = 10.0;
uniform uint FrameCounter;

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(resolution.x) || pixel_coords.y >= int(resolution.y)) {
        return;
    }

    // Initialize Sobol sampler for quasi-random sampling
    SobolSampler sobol_sampler = SobolSamplerNew(FrameCounter);
    SobolSamplerSetPixel(sobol_sampler, pixel_coords.x, pixel_coords.y);
    SobolSamplerNextSamples(sobol_sampler, FrameCounter);

    // Create camera with depth of field
    Camera cam = CreateCamera(
        camera_position, camera_target, camera_up,
        resolution, camera_distance, camera_fov,
        camera_aperture, camera_focal_distance, false, 0
    );

    // Generate pixel sample with anti-aliasing
    vec2 pixel_center = vec2(pixel_coords);
    vec2 jitter = GaussianFilter(vec2(
        SobolSamplerGet1(sobol_sampler),
        SobolSamplerGet1(sobol_sampler)
    ));
    pixel_center += jitter;

    // Generate primary ray with depth of field
    vec2 lens_sample = vec2(
        SobolSamplerGet1(sobol_sampler),
        SobolSamplerGet1(sobol_sampler)
    );
    Ray ray = GeneratePrimaryRay(cam, pixel_center.x, pixel_center.y, lens_sample);

    // Sample wavelengths for spectral rendering
    float wavelength_sample = SobolSamplerGet1(sobol_sampler);
    SampledWavelengths lambda = SampledWavelengthsSampleVisible(wavelength_sample);

    // Initialize path tracing state
    SampledSpectrum beta = SampledSpectrumNewFloat(1.0f);
    SampledSpectrum L = SampledSpectrumNewFloat(0.0f);

    // Path tracing loop (up to 10 bounces)
    for (int bounce = 0; bounce < 10; ++bounce) {
        // Intersect ray with scene geometry
        Hit hit = BVHTraverse(ray);
        
        if (hit.distance == MaxFloat) {
            // Missed geometry - sample environment light
            vec3 unit_dir = normalize(ray.direction);
            float t = 0.5 * (unit_dir.y + 1.0);
            vec3 sky_color = mix(vec3(1.0), vec3(0.5, 0.7, 1.0), t);

            // Convert sky color to spectrum
            RGB sky_rgb = RGBNew(sky_color.r, sky_color.g, sky_color.b);
            RGBIlluminantSpectrum sky_spectrum = RGBIlluminantSpectrumNew(sky_rgb);
                
            // Evaluate spectrum at sampled wavelengths
            SampledSpectrum env_spectrum = RGBIlluminantSpectrumSample(sky_spectrum, lambda);
                
            L = Add(L, Mul(beta, env_spectrum));

            break;
        }

        // Fetch triangle data at hit point
        Triangle tri = FetchTriangle(hit.tri_index);
        vec3 position = (1.0 - hit.u - hit.v) * tri.p1 + hit.u * tri.p2 + hit.v * tri.p3;
        vec3 normal = normalize((1.0 - hit.u - hit.v) * tri.n1 + hit.u * tri.n2 + hit.v * tri.n3);

        // Prepare material evaluation info
        IntersectionInfo info;
        info.position = position;
        info.shading_normal = normal;
        info.distance = length(ray.origin - position);
        info.material.diffuse = SampledSpectrumNewFloat(0.7f); // Default gray material
        info.material.roughness = 0.0f;

        // Sample material BSDF
        vec2 bsdf_sample = vec2(
            SobolSamplerGet1(sobol_sampler),
            SobolSamplerGet1(sobol_sampler)
        );
        MaterialSampleInfo sample_info = DiffuseSample(info, -ray.direction, bsdf_sample);

        // Update path throughput
        float pdf = sample_info.pdf;
        if (pdf <= 0.0) break;

        beta = Mul(beta, DivFloat(sample_info.bsdf_cosine, pdf));

        // Russian Roulette termination
        if (bounce > 3) {
            float q = max(0.05, 1.0 - Max(beta));
            if (SobolSamplerGet1(sobol_sampler) < q) break;
            beta = DivFloat(beta, 1.0 - q);
        }

        // Update ray for next bounce
        ray = SpawnRay(info.position, info.shading_normal, sample_info.world_l, 0.0f, MaxFloat);
    }

    // Convert spectral radiance to RGB for display
    RGB linear_rgb = SampledSpectrumToRGB(L, lambda);
    RGB display_rgb = LinearToSRGB(linear_rgb);

    imageStore(outputTex, pixel_coords, vec4(display_rgb.r, display_rgb.g, display_rgb.b, 1.0));
}