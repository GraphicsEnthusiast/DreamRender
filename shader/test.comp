#version 460

#extension GL_ARB_shading_language_include : require

#include "shape/shape.glsl"
#include "spectrum/spectrum.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) writeonly uniform image2D outputTex;
            
// 相机参数 (您可以通过Uniform传递这些值，这里先写死用于测试)
vec3 camera_position = vec3(0.0, 0.0, 5.0); // 相机位置
vec3 camera_target = vec3(0.0, 0.0, 0.0);  // 相机目标点
float camera_fov = radians(60.0);           // 视野角度（弧度）

void main()
{
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputTex);
    vec2 uv = vec2(pixel_coord) / vec2(size);
    
    // 1. 构建相机坐标系并生成射线方向
    vec3 camera_dir = normalize(camera_target - camera_position);
    vec3 camera_right = normalize(cross(vec3(0.0, 1.0, 0.0), camera_dir));
    vec3 camera_up = cross(camera_dir, camera_right);
    
    // 计算射线方向 (透视投影)
    float aspect_ratio = float(size.x) / float(size.y);
    vec2 screen_pos = uv * 2.0 - 1.0; // 转换为NDC坐标 (-1到1)
    screen_pos.x *= aspect_ratio * tan(camera_fov * 0.5);
    screen_pos.y *= tan(camera_fov * 0.5);
    
    vec3 ray_dir = normalize(camera_dir + camera_right * screen_pos.x + camera_up * screen_pos.y);
    
    // 2. 创建测试射线
    Ray test_ray;
    test_ray.origin = camera_position;
    test_ray.direction = ray_dir;
    test_ray.tmin = 0.001;   // 避免自相交
    test_ray.tmax = MaxFloat; // 最大距离
    
    Hit hit = BVHTraverse(test_ray);

    vec4 color = vec4(hit.distance < MaxFloat ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), 1.0);
    
    imageStore(outputTex, pixel_coord, color);
}