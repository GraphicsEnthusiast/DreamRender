#version 460 core

layout(binding = 0, rgba32f) uniform readonly image2D CurrentFrame;
layout(binding = 1, rgba32f) uniform readonly image2D PreviousFrame;
layout(binding = 2, rgba32f) uniform writeonly image2D OutputImage;
layout(location = 0) uniform uint FrameCounter;
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    
    if (pixel_coords.x >= imageSize(OutputImage).x || 
        pixel_coords.y >= imageSize(OutputImage).y) {
        return;
    }
    
    vec4 current_color = imageLoad(CurrentFrame, pixel_coords);
    vec4 previous_color = imageLoad(PreviousFrame, pixel_coords);
    
    // Calculate blend factor based on frame counter
    // As frame counter increases, new frames contribute less to the accumulation
    float blend_factor = 1.0f / float(FrameCounter + 1);
    
    // Blend between current and previous frames using mix function
    // mix(x, y, a) = x * (1 - a) + y * a
    // So with blend_factor = 1 / (n + 1), we get:
    // result = previous * (1 - 1 / (n + 1)) + current * (1 / (n + 1))
    //        = previous * (n / (n + 1)) + current * (1 / (n + 1))
    vec4 blended_color = mix(previous_color, current_color, blend_factor);
    
    imageStore(OutputImage, pixel_coords, blended_color);
}